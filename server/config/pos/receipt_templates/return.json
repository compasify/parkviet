{
  "schema": 1,
  "page": {
    "margin_mm": 3,
    "font": "sans",
    "font_size": "m",
    "line_spacing": 1.35
  },
  "header": [
    {
      "type": "business",
      "fields": [
        "name",
        "address",
        "phone",
        "branch"
      ],
      "align": "center"
    },
    {
      "type": "text",
      "value": "{register.name}",
      "align": "center"
    },
    {
      "type": "title"
    }
  ],
  "meta": {
    "fields": [
      "time",
      "cashier",
      "order_number",
      "return_number",
      "customer"
    ],
    "labels": {}
  },
  "lines": {
    "layout": "stacked",
    "columns": [
      "name",
      "amount"
    ],
    "show_trace": false,
    "show_conversion": false
  },
  "totals": {
    "fields": [
      "total"
    ],
    "labels": {}
  },
  "footer": []
}
