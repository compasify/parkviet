# ParkViet production settings. Copy to .env.prod (gitignored), fill in, and
# keep a copy somewhere safe: losing the encryption keys makes encrypted data
# unreadable. deploy/scripts/install-lan.sh creates .env.prod with fresh
# secrets. Placeholders only in this file: never commit real values.

# --- Address and TLS --------------------------------------------------------
# The address devices use to reach this server. It goes into every pairing
# QR; changing it means pairing the devices again.
#   Shop LAN, plain HTTP:  http://192.168.1.10  or  http://pos.local
#   Shop LAN, Caddy's CA:  https://192.168.1.10
#   VPS:                   https://pos.example.vn
# Plain http:// is accepted only for a private IP (10/8, 172.16/12,
# 192.168/16) or a .local name.
POS_PUBLIC_BASE_URL=http://192.168.1.10
# none | internal | public. Must match the scheme above; left empty, http://
# means none and https:// means public.
POS_TLS_MODE=none
# What Caddy serves (deploy/Caddyfile):
#   none      http://
#   internal  https://192.168.1.10
#   public    pos.example.vn
POS_CADDY_SITE=http://
# Extra host names the app answers to, comma separated (the tunnel hostname).
POS_EXTRA_HOSTS=
# Host used in generated URLs (images, email links). Defaults to the host of
# POS_PUBLIC_BASE_URL.
SPREE_HOST=

# --- Secrets (generate, never reuse between shops) --------------------------
# openssl rand -hex 64
SECRET_KEY_BASE=change-me
# openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# openssl rand -base64 32, one value each. Never change once data exists.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=change-me
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=change-me
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=change-me
# /jobs dashboard (Mission Control) basic auth.
MISSION_CONTROL_USER=jobs
MISSION_CONTROL_PASSWORD=change-me

# --- App ---------------------------------------------------------------------
RAILS_LOG_LEVEL=info
# Label of the built release, shown on the system status page.
PARKVIET_VERSION=development
# Image tag to run. Leave the default to build from this checkout.
PARKVIET_IMAGE=parkviet-spree:latest

# --- Mail (optional) ----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# --- Backups -------------------------------------------------------------------
# Local time (HHMM) after which the nightly dump runs, and how many to keep.
BACKUP_AT=0230
BACKUP_KEEP=14
# POSIX TZ string for the backup clock. ICT-7 is Vietnam (UTC+7).
BACKUP_TZ=ICT-7

# --- Off-site copy (profile "offsite", optional) ---------------------------
# rclone remote defined by environment variables, for example an S3-compatible
# bucket. See https://rclone.org/docs/#config-file and https://rclone.org/s3/.
RCLONE_DESTINATION=offsite:parkviet-backups/shop-name
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Other
RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.example.com
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=change-me
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=change-me
